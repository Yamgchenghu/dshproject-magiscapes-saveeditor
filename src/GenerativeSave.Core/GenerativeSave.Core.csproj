<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>GenerativeSave.Core</RootNamespace>
    <AssemblyName>GenerativeSave.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- The starter library ships inside the executable so a fresh install has
         item and NPC names immediately. It is only written out when the user
         has no catalog.json of their own. -->
    <EmbeddedResource Include="Library\catalog.json" />
  </ItemGroup>

</Project>
